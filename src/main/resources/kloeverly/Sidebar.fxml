<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="kloeverly.controller.SidebarController"
      prefWidth="190"
      minWidth="190"
      maxWidth="190"
      spacing="6"
      styleClass="sidebar">

    <Label text="KLØVERLY"
           styleClass="sidebar-brand"/>

    <Label text="Administration"
           styleClass="sidebar-subtitle"/>

    <Region prefHeight="25"/>

    <Button text="Dashboard"
            maxWidth="Infinity"
            alignment="CENTER_LEFT"
            onAction="#visDashboard"
            styleClass="nav-button"/>

    <Button text="Beboere"
            maxWidth="Infinity"
            alignment="CENTER_LEFT"
            onAction="#visBeboere"
            styleClass="nav-button"/>

    <Button text="Opgaver"
            maxWidth="Infinity"
            alignment="CENTER_LEFT"
            onAction="#visOpgaver"
            styleClass="nav-button"/>

    <Button text="Point"
            maxWidth="Infinity"
            alignment="CENTER_LEFT"
            onAction="#visPoint"
            styleClass="nav-button"/>

    <Button text="Rapport"
            maxWidth="Infinity"
            alignment="CENTER_LEFT"
            onAction="#visRapport"
            styleClass="nav-button"/>

    <Region VBox.vgrow="ALWAYS"/>

    <Label text="Lokalt administrationssystem"
           wrapText="true"
           styleClass="sidebar-footer"/>

</VBox>