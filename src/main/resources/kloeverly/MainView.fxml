<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="kloeverly.controller.MainController">

    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="20"
              styleClass="page-content">

            <VBox spacing="3">
                <Label text="Dashboard"
                       styleClass="page-title"/>

                <Label text="Overblik over Kløverly"
                       styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="12">

                <VBox spacing="5"
                      prefWidth="165"
                      styleClass="stat-card">

                    <Label text="Beboere"
                           styleClass="stat-label"/>

                    <Label fx:id="antalBeboereLabel"
                           text="0"
                           styleClass="stat-number"/>
                </VBox>

                <VBox spacing="5"
                      prefWidth="165"
                      styleClass="stat-card">

                    <Label text="Opgaver"
                           styleClass="stat-label"/>

                    <Label fx:id="antalOpgaverLabel"
                           text="0"
                           styleClass="stat-number"/>
                </VBox>

                <VBox spacing="5"
                      prefWidth="165"
                      styleClass="stat-card">

                    <Label text="Personlige point"
                           styleClass="stat-label"/>

                    <Label fx:id="personligePointLabel"
                           text="0"
                           styleClass="stat-number"/>
                </VBox>

                <VBox spacing="5"
                      prefWidth="165"
                      styleClass="stat-card">

                    <Label text="Fælles point"
                           styleClass="stat-label"/>

                    <Label fx:id="faellesPointLabel"
                           text="0"
                           styleClass="stat-number"/>
                </VBox>

            </HBox>

            <VBox spacing="10"
                  styleClass="card">

                <Label text="Aktive opgaver"
                       styleClass="section-title"/>

                <ListView fx:id="senesteOpgaverListView"
                          prefHeight="310"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>